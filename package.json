{
  "name": "playwright-bdd-project",
  "version": "1.0.0",
  "type": "module",
  "description": "Playwright + TypeScript automation framework (POM) for UI and API tests.",
  "scripts": {
    "clean": "rimraf reports allure-results reports/allure-report screenshots",
    "build": "tsc",
    "lint": "echo 'Add lint steps'",
    "install:browsers": "npx playwright install",
    "test": "npx playwright test",
    "test:ui": "npx playwright test tests/ui --reporter=list,html",
    "test:api": "npx playwright test tests/api --reporter=list,html",
    "test:all": "npm run test",
    "report:playwright": "npx playwright show-report",
    "report:allure": "allure generate allure-results --clean -o reports/allure-report || true"
  },
  "keywords": ["playwright", "ui", "api"],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "typescript": "^5.2.2",
    "ts-node": "^10.9.1",
    "dotenv": "^16.3.1",
    "rimraf": "^5.0.0",
    "allure-playwright": "^3.3.0",
    "allure-commandline": "^2.13.9",
    "ajv": "^8.12.0",
    "winston": "^3.9.0",
    "@types/node": "^26.1.2"
  }
}
